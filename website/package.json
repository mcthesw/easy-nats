{
  "name": "easy-nats-website",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.1.2",
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build ../crates/app --target web --out-dir ../../website/src/generated --out-name easy_nats --no-pack",
    "dev": "pnpm build:wasm && vite",
    "build": "pnpm build:wasm && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vue-tsc": "^3.3.8"
  },
  "dependencies": {
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.7"
  }
}
